  "keywords": [
    "vpn",
    "openvpn",
    "openvpn3",
    "networking",
    "security",
    "on-demand"
  ],
  "license": "AGPL-3.0-only",
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
